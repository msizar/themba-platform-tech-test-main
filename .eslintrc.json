{
  "extends": [
    "airbnb",
    "airbnb/hooks"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "react/jsx-uses-react": "off",
    "react/react-in-jsx-scope": "off",
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "always",
        "jsx": "always"
      }
    ],
    "no-console": "warn",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.js",
        "**/*.test.jsx"
      ],
      "env": {
        "jest": true
      }
    },
    {
      "files": [
        "**/vite.config.js",
        "**/vitest.config.js",
        "**/tailwind.config.js"
      ],
      "rules": {
        "import/no-extraneous-dependencies": "off",
        "import/no-unresolved": "off"
      }
    },
    {
      "files": [
        "backend/src/index.js"
      ],
      "rules": {
        "no-underscore-dangle": "off",
        "no-console": "off"
      }
    }
  ]
}
